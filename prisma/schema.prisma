// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Order {
  id        String   @id @default(cuid())
  status    String
  createdAt DateTime @default(now())
}

model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Int
}
